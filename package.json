{
  "name": "breakpilot-debug-mcp",
  "version": "0.1.0",
  "description": "AI-callable multi-language runtime debugging MVP with MCP, DAP, CLI, and IDE bridge scaffolding.",
  "type": "module",
  "bin": {
    "debug-mcp": "./src/cli.ts",
    "debug-mcp-server": "./src/server.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "serve:http": "node --experimental-strip-types src/server.ts --http-port 27890 --ide-bridge-port 27891",
    "cli": "node --experimental-strip-types src/cli.ts",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "check:runtime": "node --experimental-strip-types src/cli.ts tools > /dev/null && node --experimental-strip-types test/smoke.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "mcp",
    "dap",
    "debugger",
    "ai-debugging"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
