{
  "name": "@breakpilot/cli",
  "version": "0.1.0",
  "description": "AI-callable multi-language runtime debugging MVP with MCP, DAP, CLI, and IDE bridge scaffolding.",
  "type": "module",
  "bin": {
    "breakpilot": "./bin/breakpilot.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "docs/architecture.md",
    "docs/control-tools.md",
    "docs/mcp-tools.md",
    "docs/project-structure.md",
    "breakpilot.yaml",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/serve.ts",
    "serve:http": "node --experimental-strip-types src/serve.ts --http-port 57987",
    "cli": "node --experimental-strip-types src/cli.ts",
    "smoke": "node --experimental-strip-types test/smoke.ts",
    "check:runtime": "node --experimental-strip-types src/cli.ts tools > /dev/null && node --experimental-strip-types test/smoke.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-bridge-assets.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "mcp",
    "dap",
    "debugger",
    "ai-debugging"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.35",
    "fast-check": "^4.8.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  }
}
