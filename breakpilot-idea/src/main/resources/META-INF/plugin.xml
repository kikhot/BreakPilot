<idea-plugin>
    <id>com.breakpilot.debugger</id>
    <name>BreakPilot</name>
    <vendor>BreakPilot</vendor>
    <description>Expose IDEA XDebugger sessions to BreakPilot over the local IDE bridge.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="plugin.BreakPilotIdeaPlugin"/>
        <projectConfigurable
                parentId="tools"
                instance="settings.BreakPilotSettingsConfigurable"
                id="breakpilot.settings"
                displayName="BreakPilot"/>
        <notificationGroup id="BreakPilot" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
